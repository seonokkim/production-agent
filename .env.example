# Copy to .env and fill secrets locally. Never commit .env.

APP_ENV=development
APP_NAME=Production Agent

# SQLite (default) or PostgreSQL (docker compose)
DATABASE_URL=sqlite:///./data/production_agent.db
# DATABASE_URL=postgresql+psycopg://production:production@127.0.0.1:5432/production_agent

GENERATION_PROVIDER=mock
# GENERATION_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8189
# COMFYUI_PUBLIC_URL=
# COMFYUI_INPUT_DIR=./comfy_runtime/input

LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# FE defaults to :5173 in config; override if you use another Vite port
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ASSET_STORAGE_PATH=./storage
ASSET_STORAGE_PROVIDER=local
ASSET_LANDING_PATH=./storage/landing
# AWS_S3_BUCKET=
# AWS_REGION=ap-northeast-2

# Optional n8n review webhook (docker compose --profile ops)
# N8N_REVIEW_WEBHOOK_URL=http://127.0.0.1:5678/webhook/asset-review

POLL_INTERVAL_SECONDS=2

# P1 — Approved Reference Retrieval
EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=marengo
TWELVE_LABS_API_KEY=
EMBEDDING_MODEL=marengo3.5
EMBEDDING_DIM=512

# P2 — Multimodal RAG (OpenAI Agents SDK; install be extras: pip install -e ".[agents]")
AGENTS_SDK_ENABLED=true
OPENAI_AGENT_MODEL=gpt-4o-mini
AGENT_LLM_PROVIDER=openai
# AGENT_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_AGENT_MODEL=qwen3:8b
# AGENT_LLM_PROVIDER=hf
# HF_TOKEN=
# HF_AGENT_MODEL=Qwen/Qwen3-8B
# HF_LLM_BASE_URL=http://127.0.0.1:8002
