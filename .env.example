# Copy to .env and fill secrets locally. Never commit .env.

APP_ENV=development
APP_NAME=Production Agent

# SQLite (default) or PostgreSQL (docker compose)
DATABASE_URL=sqlite:///./data/production_agent.db
# DATABASE_URL=postgresql+psycopg://production:production@127.0.0.1:5432/production_agent

GENERATION_PROVIDER=mock
# GENERATION_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188

LLM_PROVIDER=mock
# LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# This repo serves FE on :5174 (sibling production-agent-dev uses :5173)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

ASSET_STORAGE_PATH=./storage
POLL_INTERVAL_SECONDS=2

# P1 — Approved Reference Retrieval
EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=marengo
TWELVE_LABS_API_KEY=
EMBEDDING_MODEL=marengo3.5
EMBEDDING_DIM=512

# P2 — Multimodal RAG (OpenAI Agents SDK; install be extras: pip install -e ".[agents]")
AGENTS_SDK_ENABLED=true
OPENAI_AGENT_MODEL=gpt-4o-mini
